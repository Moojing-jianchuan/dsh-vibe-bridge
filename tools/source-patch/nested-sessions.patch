+const sessionsOf = (
+  items: readonly SessionSummary[],
+  catalogs: Readonly<Record<string, SessionProjectionSnapshot>> = {},
+): SessionListState => ({
+  ids: items.map(item => item.id),
+  byId: Object.fromEntries(items.map(item => [item.id, item])),
+  phase: 'ready',
+  projectionsBySession: catalogs,
+})
