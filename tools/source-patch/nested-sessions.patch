+/**
+ * Parent-plus-children list driven by the real derivation: the fold state lives
+ * here exactly as the browser keeps it, so a toggle click re-derives the rows.
+ * @param props.list - sessions snapshot carrying the parent's catalog.
+ * @param props.workspaces - the expanded Workspace group.
+ * @param props.state - pin, archive, and archived-filter membership.
+ * @param props.onOpen - open a row by id.
+ * @param props.onRenameRequest - open Rename from a title double-click.
+ * @param props.expansion - initial persisted folds, keyed as the browser stores them.
+ * @param props.slots - row-list renderer; defaults to rendering no entries.
+ * @returns every derived row, children indented under their parent.
+ */
+function ChildRowTree({
+  list, workspaces, state, onOpen, onRenameRequest, expansion = {}, slots = renderNoRowEntries,
+}: {
+  list: SessionListState
+  workspaces: readonly WorkspaceView[]
+  state: SessionRowState
+  onOpen: (id: SessionId) => void
+  onRenameRequest: (id: SessionId, title: string) => void
+  expansion?: Readonly<Record<string, boolean>>
+  slots?: RowRenderSlot
+}) {
+  const [groupExpansion, setGroupExpansion] = useState<Readonly<Record<string, boolean>>>(expansion)
+  const rows = deriveGroups(list, workspaces, state, noStatuses, {
+    expandedGroups: workspaces.map(entry => entry.workspaceId),
+    groupExpansion,
+  }).flatMap(group => group.sessions)
+  const drag = dragProps()
+  return (
+    <>
+      {rows.map(row => (
+        <SessionNodeItem
+          key={row.id}
+          node={row}
+          currentId={undefined}
+          now={0}
+          onOpen={onOpen}
+          onRenameRequest={onRenameRequest}
+          onToggleChildRows={(id, expanded) => {
+            setGroupExpansion(previous => ({ ...previous, [childRowsKey(id)]: expanded }))
+          }}
+          drag={row.childOf === undefined ? drag : undefined}
+          renderSlot={slots}
+          t={t}
+        />
+      ))}
+    </>
+  )
+}
+
+/** A live parent with one live and one archived child, plus an external catalog entry. */
+function family(): {
+  list: SessionListState
+  workspaces: readonly WorkspaceView[]
+} {
+  const parent = summary('parent', 30, { title: 'Parent session' })
+  const liveChild = childSummary('live-child', 20, parent.id)
+  const archivedChild = childSummary('archived-child', 10, parent.id)
+  return {
+    list: sessionsOf([parent, liveChild, archivedChild], {
+      [parent.id]: catalogOf({ id: 'live-child' }, { id: 'archived-child' }, { id: 'external-child', mode: 'external' }),
+    }),
+    workspaces: [workspace('ws', ['parent', 'live-child', 'archived-child'])],
+  }
+}
+
+function mountFamily(options: {
+  state?: SessionRowState
+  expansion?: Readonly<Record<string, boolean>>
+} = {}): { onOpen: Mock; onRenameRequest: Mock } {
+  const onOpen = vi.fn()
+  const onRenameRequest = vi.fn()
+  const { list, workspaces } = family()
+  render(
+    <ChildRowTree
+      list={list}
+      workspaces={workspaces}
+      state={options.state ?? noRows}
+      onOpen={onOpen}
+      onRenameRequest={onRenameRequest}
+      {...options.expansion === undefined ? {} : { expansion: options.expansion }}
+    />,
+  )
+  return { onOpen, onRenameRequest }
+}
