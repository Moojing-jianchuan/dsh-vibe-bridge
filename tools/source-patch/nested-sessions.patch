+type RowSlotName =
+  | 'sidebar.workspaces.session.menu.item'
+  | 'sidebar.workspaces.session.row.action'
+  | 'sidebar.session.row.leading'
+  | 'sidebar.session.row.hover'
+type RowRenderSlot = PropsRenderSlots<RowSlotName>['renderSlot']
+
+/** No row lists, leading decorations, or hover sections: the rows render bare. */
+const renderNoRowEntries: RowRenderSlot = () => null
+
+/** One recorded `renderSlot` occurrence: which row list asked for which Session. */
+interface SlotCall {
+  /** Slot name as authored by the row; the assertions pin the exact names. */
+  name: string
+  sessionId: SessionId
+}
+
+/**
+ * Record the row lists each row asks for. The renderer resolves entries from
+ * these calls, so a list a row never asks for is a list no entry can occupy.
+ * The action list renders one pressable stand-in, so a test can press an entry
+ * the way a user does.
+ * @returns the stub renderer and the calls it collected.
+ */
+function recordingSlots(): { renderSlot: RowRenderSlot; calls: SlotCall[] } {
+  const calls: SlotCall[] = []
+  // The slot renderer is generic over the slot name, so its own parameters
+  // carry no contextual type here; the owner is the row identity every row
+  // seat takes.
+  const renderSlot: RowRenderSlot = (name: string, owner: object) => {
+    calls.push({ name, sessionId: (owner as { sessionId: SessionId }).sessionId })
+    // Both row action lists stamp one entry so a press can be aimed at either.
+    return name === 'sidebar.workspaces.session.row.action' || name === 'sidebar.workspaces.session.childRow.action'
+      ? <button type="button" data-testid="row-action-entry" />
+      : null
+  }
+  return { renderSlot, calls }
+}
