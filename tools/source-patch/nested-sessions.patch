+/** The row element owning one title: the same association the pointer handlers use. */
+function titleRow(title: string): HTMLElement {
+  const row = screen.getByText(title).closest<HTMLElement>('[role="treeitem"]')
+  if (row === null) throw new Error(`no session row owns the title ${title}`)
+  return row
