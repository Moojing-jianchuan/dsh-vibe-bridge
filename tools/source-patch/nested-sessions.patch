+const summary = (id: string, updatedAt: number, overrides: Partial<SessionSummary> = {}): SessionSummary => ({
+  id: sid(id), title: id, displayTitle: id, running: false, blank: false,
+  retainedBy: {}, updatedAt, ...overrides,
+})
+
+/** A subagent child: catalogued by its parent and hidden as a top-level row. */
+const childSummary = (id: string, updatedAt: number, parentId: SessionId): SessionSummary =>
+  summary(id, updatedAt, { origin: 'subagent' as const, parentId })
+
+const catalogOf = (...entries: readonly { id: string; mode?: 'continuable' | 'external' }[]): SessionProjectionSnapshot => ({
+  values: {
